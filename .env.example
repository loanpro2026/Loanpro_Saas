# ═══════════════════════════════════════════════════════════════════
# LoanPro Web — environment
#
# Every variable here is read by the code. Nothing is aspirational.
# Verify with: npm run check:env
#
# NOTE: this app has its own Supabase project and R2 bucket. The optional
# Android companion integration reuses the existing Cloud Run service only
# as a temporary photo transport; permanent photos still live only in R2.
# ═══════════════════════════════════════════════════════════════════


# ── Supabase — REQUIRED ─────────────────────────────────────────────
# From your NEW project: Dashboard → Project Settings → API.
#
# These CANNOT be reused from any other project. Keys are bound to one
# project; another project's key simply will not authenticate.
#
# The anon key is public — it ships to the browser, and row-level
# security is what protects your data, not the key's secrecy.
#
# The SERVICE ROLE key bypasses row-level security completely. Anything
# holding it can read and write every shop's records. It belongs only in
# Vercel's server-side environment and your local .env.local. Never in a
# NEXT_PUBLIC_ variable, never in the browser, never in git.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# ── Cloudflare R2 — REQUIRED (customer photos) ──────────────────────
# Cloudflare Dashboard → R2 → Manage API Tokens → Create API Token
#   Permission: "Object Read & Write", scoped to this bucket only.
# The account ID is in the R2 sidebar and in your dashboard URL.
#
# Keep the bucket PRIVATE. Do not enable public access, do not attach an
# r2.dev domain. These are customer identity photos. Every read goes
# through /api/photos/:loanId, which checks the session first and then
# issues a URL that expires in five minutes.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=loanpro-photos


# â”€â”€ Android companion / Cloud Run â€” OPTIONAL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Enables Settings â†’ Preferences â†’ Paired phone capture. Both values are
# server-only. MOBILE_CAPTURE_API_KEY must equal API_AUTH_TOKEN on the
# existing Cloud Run mobile capture service. Never add NEXT_PUBLIC_ here.
MOBILE_CAPTURE_API_BASE_URL=https://your-service-id-your-region.run.app
MOBILE_CAPTURE_API_KEY=replace-with-the-rotated-cloud-run-api-token


# ── App URL — REQUIRED ──────────────────────────────────────────────
# Must be the real, final domain. Staff invitation links are built from
# window.location.origin, and Supabase Auth redirect URLs must match this
# exactly. A wrong value produces invitations that go nowhere.
#
# Vercel preview deployments get their own URL — set this per-environment
# in Vercel rather than hard-coding one value everywhere.
NEXT_PUBLIC_APP_URL=https://yourdomain.com


# ── Web Push / VAPID — REQUIRED for phone camera capture ────────────
# Generate a fresh pair, it takes a second:
#   npx web-push generate-vapid-keys
#
# Do not reuse a pair from another app. Push subscriptions are bound to
# the public key, so sharing one means two apps that can notify each
# other's users.
#
# Reaches Android Chrome, iOS 16.4+ installed as a PWA, and desktop
# Chrome. There is no Firebase here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BNxxxx...
VAPID_PRIVATE_KEY=xxxx...
VAPID_CONTACT_EMAIL=you@yourdomain.com


# ── Razorpay — OPTIONAL until you take payments ─────────────────────
# Safe to reuse from loanpro_web: the key pair identifies your BUSINESS
# account, not one application.
#
# The WEBHOOK SECRET is different. Razorpay generates one per webhook
# endpoint, and this app needs its own endpoint pointing at
# https://yourdomain.com/api/webhooks/razorpay — so create a new webhook
# and use the secret it gives you. Reusing loanpro_web's will fail
# signature verification on every call.
#
# You can leave all four blank for now. Plans are set by hand in the
# Supabase dashboard (tenants.plan / plan_status) while you onboard
# shops personally, and nothing in the app breaks without these.
# Keep this set to `disabled` until test checkout is intentionally enabled.
# Allowed values: disabled | test | live. The server rejects every order and
# webhook while disabled, even if Razorpay keys happen to be present.
BILLING_MODE=disabled
STAFF_ACCESS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=


# ── Migration CLI only — NEVER set in Vercel ────────────────────────
# The desktop MySQL of the shop you are migrating. Read only when you run
# `npm run migrate:tenant` by hand on your own machine.
# MIGRATE_MYSQL_HOST=127.0.0.1
# MIGRATE_MYSQL_PORT=3307
# MIGRATE_MYSQL_USER=root
# MIGRATE_MYSQL_PASSWORD=
# MIGRATE_MYSQL_DATABASE=loan_management
