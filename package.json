{
  "name": "loanpro-saas",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:types:sql": "python scripts/gen-types.py",
    "db:link": "supabase link",
    "db:types": "supabase gen types typescript --linked --schema public > types/supabase.ts",
    "db:types:local": "supabase gen types typescript --local --schema public > types/supabase.ts",
    "migrate:tenant": "tsx --env-file=.env.local scripts/migrate-tenant.ts",
    "migrate:reconcile": "tsx --env-file=.env.local scripts/reconcile.ts",
    "migrate:test": "tsx scripts/lib/map.test.ts",
    "test:cash": "node scripts/lib/cash.test.mjs",
    "test:reports": "node scripts/lib/reports.test.mjs",
    "test:interest": "node scripts/lib/interest.test.mjs",
    "test:offline": "node scripts/lib/offline.test.mjs",
    "test:plans": "node scripts/lib/plans.test.mjs",
    "check:rpc": "node scripts/rpc.js",
    "check:guard": "node scripts/guard.js",
    "check:links": "node scripts/links.js",
    "check:parity": "node scripts/parity.js",
    "check:deps": "node scripts/deps.js",
    "check:env": "node scripts/env.js",
    "check:sql": "node scripts/sql.js",
    "check:syntax": "node scripts/check.js && node scripts/imports.js && node --check public/sw.js",
    "test": "npm run migrate:test && npm run test:cash && npm run test:reports && npm run test:interest && npm run test:offline && npm run test:plans && npm run check:rpc && npm run check:guard && npm run check:links && npm run check:parity && npm run check:deps && npm run check:syntax"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@hookform/resolvers": "^5.1.1",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "archiver": "^7.0.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.544.0",
    "next": "^15.5.22",
    "razorpay": "^2.9.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.62.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.3.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.5.4",
    "mysql2": "^3.14.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  }
}
