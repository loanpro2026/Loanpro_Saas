# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Cloudflare R2 (customer photos) ───────────────────────────
# Cloudflare Dashboard → R2 → Manage API Tokens → Create API Token
#   Permission: "Object Read & Write", scoped to the loanpro-photos bucket.
# The account id is in the R2 sidebar / your dashboard URL.
#
# Keep the bucket PRIVATE. Do not enable public access or attach a public
# r2.dev domain — these are customer identity photos. All reads go through
# /api/photos/:loanId, which authorises first and then issues a 5-minute
# presigned URL.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=loanpro-photos

# ── Migration script only (scripts/migrate-tenant.ts) ─────────
# Source MySQL of the desktop app being migrated. Leave unset in production;
# this is read only when you run the CLI by hand.
# MIGRATE_MYSQL_HOST=localhost
# MIGRATE_MYSQL_PORT=3307
# MIGRATE_MYSQL_USER=root
# MIGRATE_MYSQL_PASSWORD=
# MIGRATE_MYSQL_DATABASE=loan_management

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# Razorpay Webhook
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# App
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_APP_NAME=LoanPro

# Internal cron protection
CRON_SECRET=your-cron-secret

# ── Web Push / VAPID (phone camera capture) ───────────────────
# Reaches Android Chrome, iOS 16.4+ installed as a PWA, and desktop Chrome.
# There is no Firebase here — FCM was only needed for the native Android app,
# which belongs to the desktop product.
# Generate a VAPID key pair once:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BNxxxx...
VAPID_PRIVATE_KEY=xxxx...
VAPID_CONTACT_EMAIL=admin@yourdomain.com
